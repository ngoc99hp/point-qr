# Copy to .env.local for local development. Never commit real values.

# Neon connection string WITH pooling (host contains -pooler) — used by the app at runtime.
# Neon console: Dashboard > Connect > enable "Connection pooling".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional. Direct (non-pooled) URL for Prisma CLI (migrate/deploy). If omitted it is
# derived from DATABASE_URL by removing "-pooler" from the host.
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Auth.js session secret — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# The single admin account (SPEC §9.5). Password must be at least 16 characters.
ADMIN_EMAIL=admin@hpu.edu.vn
ADMIN_PASSWORD=

# Optional: only needed for `pnpm start` / self-hosting outside Vercel
# (Vercel and `pnpm dev` trust the host automatically).
# AUTH_TRUST_HOST=true

# >= 32 random characters — generate with: openssl rand -base64 48
TICKET_SECRET=

# Public base URL of the app (used to build QR links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
