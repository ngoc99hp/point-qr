# Copy to .env.local for local development. Never commit real values.

# Neon pooled connection (host contains -pooler) — used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon direct connection (no -pooler) — used by Prisma CLI (migrate/deploy)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: only needed for `pnpm start` / self-hosting outside Vercel
# (Vercel and `pnpm dev` trust the host automatically).
# AUTH_TRUST_HOST=true

# Comma-separated lecturer emails allowed to sign in (case-insensitive)
ALLOWED_LECTURER_EMAILS=a@hpu.edu.vn,b@hpu.edu.vn

# >= 32 random characters — generate with: openssl rand -base64 48
TICKET_SECRET=

# Public base URL of the app (used to build QR links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
